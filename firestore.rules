rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Nega acesso indiscriminado por padrão
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function currentUserTenant() {
      return userDocExists() && ('tenantId' in getUserData())
        ? getUserData().tenantId
        : 'buffet-principal';
    }

    // Regra para perfil de usuários
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Regras multitenant para entidades de domínio (events, checklists, recipes, support_materials, etc.)
    match /{collectionName}/{docId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        !('tenantId' in resource.data) ||
        resource.data.tenantId == currentUserTenant() ||
        resource.data.tenantId == 'buffet-principal' ||
        resource.data.tenantId == 'default-tenant'
      );
      allow create: if isAuthenticated() && (
        !('tenantId' in request.resource.data) ||
        request.resource.data.tenantId == currentUserTenant() ||
        request.resource.data.tenantId == 'buffet-principal' ||
        request.resource.data.tenantId == 'default-tenant'
      );
      allow update, delete: if isAuthenticated() && (
        resource == null ||
        !('tenantId' in resource.data) ||
        resource.data.tenantId == currentUserTenant() ||
        resource.data.tenantId == 'buffet-principal' ||
        resource.data.tenantId == 'default-tenant'
      );
    }
  }
}
